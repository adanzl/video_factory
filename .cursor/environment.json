{
  "name": "video_factory",
  "install": "bash .cursor/install.sh",
  "terminals": [
    {
      "name": "backend",
      "command": "cd backend && ../.venv/bin/python main.py"
    },
    {
      "name": "frontend",
      "command": "cd frontend && VITE_API_BASE_URL=http://localhost:9002 npm run dev"
    }
  ],
  "ports": [
    { "name": "backend", "port": 9002 },
    { "name": "frontend", "port": 5175 }
  ]
}
